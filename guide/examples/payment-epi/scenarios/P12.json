{
    "id": "P12",
    "title": "Refund twice: two identical partial Credit requests are two refunds",
    "amount": "100.00",
    "steps": [
        {
            "call": "startPayment",
            "key": "{{paymentKey}}",
            "args": {
                "methodId": "{{methodId}}",
                "amount": "{{amount}}",
                "currencyCode": "{{currencyCode}}",
                "direction": "Payment",
                "debitSynchronously": true,
                "payer": "{{payer}}",
                "payee": "{{payee}}",
                "token": "{{token}}",
                "locale": "{{locale}}",
                "specification": "{{specification}}"
            },
            "expect": {
                "status": 200,
                "schema": "StepComplete",
                "events": [
                    "Complete"
                ],
                "actions": [
                    [
                        "Authorize",
                        "Debit"
                    ]
                ],
                "echo": [
                    "methodId",
                    "amount",
                    "currencyCode",
                    "token"
                ],
                "derivedStatus": [
                    "Debited"
                ]
            }
        },
        {
            "call": "transaction",
            "key": "{{paymentKey}}",
            "args": {
                "actions": [
                    "Credit"
                ],
                "token": "{{token}}",
                "amount": "40.00",
                "currencyCode": "{{currencyCode}}",
                "methodId": "{{methodId}}",
                "reversalArgs": {
                    "originalTransactionId": "{{transactions.0.transactionId}}",
                    "originalTimestamp": "{{transactions.0.timestamp}}"
                }
            },
            "expect": {
                "status": 200,
                "schema": "TransactionDto",
                "actions": [
                    [
                        "Credit"
                    ]
                ],
                "echo": [
                    "methodId",
                    "amount",
                    "currencyCode",
                    "token"
                ],
                "derivedStatus": [
                    "Credited",
                    "Debited"
                ]
            }
        },
        {
            "call": "transaction",
            "key": "{{paymentKey}}",
            "args": {
                "actions": [
                    "Credit"
                ],
                "token": "{{token}}",
                "amount": "40.00",
                "currencyCode": "{{currencyCode}}",
                "methodId": "{{methodId}}",
                "reversalArgs": {
                    "originalTransactionId": "{{transactions.0.transactionId}}",
                    "originalTimestamp": "{{transactions.0.timestamp}}"
                }
            },
            "expect": {
                "status": 200,
                "schema": "TransactionDto",
                "actions": [
                    [
                        "Credit"
                    ]
                ],
                "echo": [
                    "methodId",
                    "amount",
                    "currencyCode",
                    "token"
                ],
                "distinct": true,
                "derivedStatus": [
                    "Credited",
                    "Debited"
                ]
            }
        }
    ]
}
