                "direction": "Payment",
                "debitSynchronously": true,
                "payer": "{{payer}}",
                "payee": "{{payee}}",
                "token": "{{token}}",
                "locale": "{{locale}}",
                "specification": "{{specification}}"
            },
            "expect": {
                "status": 200,
                "schema": "StepDecline",
                "events": [
                    "Decline"
                ],
                "translatedReason": true
            }
        }
    ]
