{
    "id": "P3",
    "title": "Two-step sale without debitSynchronously: Authorize, then release with Annul",
    "amount": "100.05",
    "steps": [
        {
            "call": "startPayment",
            "key": "{{paymentKey}}",
            "args": {
                "methodId": "{{methodId}}",
                "amount": "{{amount}}",
                "currencyCode": "{{currencyCode}}",
                "direction": "Payment",
                "payer": "{{payer}}",
                "payee": "{{payee}}",
                "token": "{{token}}",
                "locale": "{{locale}}",
                "specification": "{{specification}}"
            },
            "expect": {
                "status": 200,
                "schema": "StepComplete",
                "events": [
                    "Complete"
                ],
                "actions": [
                    [
                        "Authorize"
                    ]
                ],
                "echo": [
                    "methodId",
                    "amount",
                    "currencyCode",
                    "token"
                ],
                "derivedStatus": [
                    "Authorized"
                ]
            }
        },
        {
            "call": "transaction",
            "key": "{{paymentKey}}",
            "args": {
                "actions": [
                    "Annul"
                ],
                "token": "{{token}}",
                "amount": "{{amount}}",
                "currencyCode": "{{currencyCode}}",
                "methodId": "{{methodId}}",
                "specification": "{{specification}}"
            },
            "expect": {
                "status": 200,
                "schema": "TransactionDto",
                "actions": [
                    [
                        "Annul"
                    ]
                ],
                "echo": [
                    "methodId",
                    "amount",
                    "currencyCode",
                    "token"
                ],
                "derivedStatus": [
                    "Annulled"
                ]
            }
        }
    ]
}
